# Copy to .env.compose and fill in your development Supabase credentials.
DATABASE_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres.project-ref
DB_PASSWORD=replace-with-your-supabase-password
JWT_SECRET=replace-with-base64-encoded-32-byte-key
MARKET_DATA_SERVICE_KEY=replace-with-random-internal-key
ANALYTICS_SERVICE_KEY=replace-with-random-internal-key
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081
FRONTEND_PORT=8081
GATEWAY_HOST_PORT=8000
# Browser API calls go through the frontend's same-origin Nginx proxy.
API_BASE_URL=/
# Each Spring datasource is capped at 2 connections. Three services use 6 total by default.
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=1
ANALYTICS_DB_POOL_MAX_SIZE=2
ANALYTICS_DB_POOL_MIN_IDLE=1
WORKFLOW_DB_POOL_MAX_SIZE=2
WORKFLOW_DB_POOL_MIN_IDLE=1
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_MAX_LIFETIME_MS=1200000
# RabbitMQ is part of the default local integration stack; these values configure it.
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
